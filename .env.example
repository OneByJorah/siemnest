# siemnest — Environment Configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Shared OpenSearch data plane (Wazuh indexer + Graylog backend) ---
# openssl rand -hex 16
INDEXER_ADMIN_PASSWORD=<set-a-strong-password>
DASHBOARD_PASSWORD=<set-a-strong-password>
DASHBOARD_USER=kibanaserver

# --- Graylog ---
# GRAYLOG_PASSWORD_SECRET: at least 64 chars - openssl rand -hex 32
GRAYLOG_PASSWORD_SECRET=<set-64-chars-min>
# GRAYLOG_ROOT_PASSWORD_SHA2: sha256 of your admin password:
#   echo -n "yourpassword" | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=<sha256-of-admin-password>
GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9000/
GRAYLOG_API_TOKEN=

# --- AI analyst ---
# Any OpenAI-compatible endpoint. Point LLM_BASE_URL at a local Ollama
# (http://host.docker.internal:11434/v1) or a hosted provider.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# --- Portal links ---
GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9000
DASHBOARD_URL=https://127.0.0.1:443
AI_URL=http://127.0.0.1:8090
